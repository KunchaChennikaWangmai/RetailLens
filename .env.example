# Retail Lens — environment variable template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# --- LLM backend: choose ONE of the two options ---

# Option A — Google AI Studio (simplest for local development)
GEMINI_API_KEY=

# Option B — Vertex AI (used on Cloud Run; auth via Application Default
# Credentials or the attached service account — no API key needed).
# Uncomment to activate:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Optional: override the Gemini model used by all agents.
# Defaults to gemini-3.6-flash (AI Studio). On Vertex AI in us-central1,
# set e.g. RETAIL_LENS_MODEL=gemini-2.5-flash.
RETAIL_LENS_MODEL=

