# Retail Lens frontend — environment template
# Copy this file to frontend/.env and adjust if needed.
#
# VITE_API_BASE_URL is the base path of the Retail Lens backend API.
# - Leave it as "/api" to use the Vite dev proxy (target: http://localhost:8000)
# - Or point it directly at a running backend, e.g. http://127.0.0.1:8000/api
VITE_API_BASE_URL=/api
